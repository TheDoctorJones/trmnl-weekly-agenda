{%- assign events = google_calendar_408243.events -%}
{%- assign today = 'now' | date: '%Y-%m-%d' -%}
{%- assign tomorrow = 'now' | date: '%s' | plus: 86400 | date: '%Y-%m-%d' -%}
{%- assign range_end = 'now' | date: '%s' | plus: 2592000 | date: '%Y-%m-%d' -%}
{%- assign today_count = 0 -%}
{%- for event in events -%}
  {%- assign d = event.date_time | date: '%Y-%m-%d' -%}
  {%- if d == today -%}{%- assign today_count = today_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign last_date = today -%}
{%- assign shown = 0 -%}

{%- comment -%} Bigger event text = fewer rows fit than the old 15-row budget.
     Tuned against the live half_vertical preview. {%- endcomment -%}
{%- assign max_rows = 12 -%}
{%- if today_count == 0 -%}{%- assign rows = 2 -%}{%- else -%}{%- assign rows = 1 -%}{%- endif -%}

<div class="layout layout--col layout--top layout--stretch-x gap--small">
  <div class="label label--base text--bold w--full bg--black text--white px--3">TODAY</div>
  {%- if today_count == 0 -%}
    <div class="label label--base px--3">No activities scheduled</div>
  {%- endif -%}

  {%- for event in events -%}
    {%- assign edate = event.date_time | date: '%Y-%m-%d' -%}
    {%- if edate >= today and edate <= range_end -%}
      {%- if edate != last_date -%}
        {%- assign needed = rows | plus: 2 -%}
      {%- else -%}
        {%- assign needed = rows | plus: 1 -%}
      {%- endif -%}
      {%- if needed > max_rows -%}{%- break -%}{%- endif -%}

      {%- if edate != last_date -%}
        {%- assign last_date = edate -%}
        {%- assign rows = rows | plus: 1 -%}
        {%- if edate == tomorrow -%}
          <div class="label label--base text--bold w--full bg--gray-65 px--3">TOMORROW</div>
        {%- else -%}
          <div class="label label--base text--bold w--full bg--gray-65 px--3">{{ event.date_time | date: '%A, %b %-d' | upcase }}</div>
        {%- endif -%}
      {%- endif -%}

      <div class="flex flex--row flex--between flex--center-y gap--small w--full px--3">
        <span class="label label--large">{{ event.summary }}</span>
        {%- unless event.all_day -%}
          <span class="label label--base label--outline no-shrink">{{ event.start }}</span>
        {%- endunless -%}
      </div>

      {%- assign shown = shown | plus: 1 -%}
      {%- assign rows = rows | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
</div>