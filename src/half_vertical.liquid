{%- assign events = google_calendar_408243.events -%}
{%- assign today = 'now' | date: '%Y-%m-%d' -%}
{%- assign tomorrow = 'now' | date: '%s' | plus: 86400 | date: '%Y-%m-%d' -%}
{%- assign range_end = 'now' | date: '%s' | plus: 2592000 | date: '%Y-%m-%d' -%}
{%- assign today_count = 0 -%}
{%- for event in events -%}
  {%- assign d = event.date_time | date: '%Y-%m-%d' -%}
  {%- if d == today -%}{%- assign today_count = today_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign last_date = today -%}
{%- assign shown = 0 -%}

{%- comment -%} Bigger type = fewer rows fit than the old 15-row budget. Tuned against the
     live half_vertical preview rather than calculated. {%- endcomment -%}
{%- assign max_rows = 8 -%}
{%- if today_count == 0 -%}{%- assign rows = 2 -%}{%- else -%}{%- assign rows = 1 -%}{%- endif -%}

<div class="layout layout--col gap--small">
  <div class="label label--large label--filled text--center px--3 py--2">TODAY</div>
  {%- if today_count == 0 -%}
    <div class="description description--base text--center">No activities scheduled</div>
  {%- endif -%}

  {%- for event in events -%}
    {%- assign edate = event.date_time | date: '%Y-%m-%d' -%}
    {%- if edate >= today and edate <= range_end -%}
      {%- if edate != last_date -%}
        {%- assign needed = rows | plus: 2 -%}
      {%- else -%}
        {%- assign needed = rows | plus: 1 -%}
      {%- endif -%}
      {%- if needed > max_rows -%}{%- break -%}{%- endif -%}

      {%- if edate != last_date -%}
        {%- assign last_date = edate -%}
        {%- assign rows = rows | plus: 1 -%}
        {%- if edate == tomorrow -%}
          <div class="label label--large bg--gray-50 text--center px--3 py--2">TOMORROW</div>
        {%- else -%}
          <div class="label label--large bg--gray-50 text--center px--3 py--2">{{ event.date_time | date: '%A, %b %-d' | upcase }}</div>
        {%- endif -%}
      {%- endif -%}

      <div class="flex flex--col gap--none">
        <span class="label label--large">{{ event.summary }}</span>
        {%- unless event.all_day -%}
          <span class="label label--small label--gray">{{ event.start }}</span>
        {%- endunless -%}
      </div>

      {%- assign shown = shown | plus: 1 -%}
      {%- assign rows = rows | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">Week Agenda</span>
</div>