{%- assign events = google_calendar_408243.events -%}

{%- comment -%} Local wall-clock reference. Liquid's `now` renders in UTC on this server,
     so after 8pm ET the UTC date has already rolled over and `today` pointed at tomorrow.
     Derive local time from the UTC epoch plus the user's offset instead. {%- endcomment -%}
{%- assign local_ts = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset -%}
{%- assign today = local_ts | date: '%Y-%m-%d' -%}
{%- assign tomorrow = local_ts | plus: 86400 | date: '%Y-%m-%d' -%}
{%- assign range_end = local_ts | plus: 2592000 | date: '%Y-%m-%d' -%}

{%- comment -%} Unique in-range dates, ascending. TODAY is seeded in so its heading
     always renders even when nothing is scheduled. {%- endcomment -%}
{%- capture date_blob -%}{{ today }},{%- for e in events -%}{%- assign ed = e.date_time | date: '%Y-%m-%d' -%}{%- if ed >= today and ed <= range_end -%}{{ ed }},{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- assign dates = date_blob | split: ',' | uniq | sort -%}

{%- comment -%} Day headers ride on label--large (Inter) and are dialed down with an
     inline font-size. TRMNL's bitmap fonts only exist at 12/16/21px, so any class
     landing at or below 16px renders pixelated — this is the way around that. {%- endcomment -%}

  
  
{%- assign head_size = 'font-size:18px' -%}
{%- assign head_padding = 'padding:6px; padding-left:10px; margin-top:12px;' -%}
{%- assign event_size = 'font-size:22px' -%}
{%- assign event_padding = 'margin-bottom:8px; margin-top:2px;' -%}


  
{%- comment -%} Vertical budget: a heading and an event row each count as 1.
     Tuned against the live half_vertical preview. {%- endcomment -%}
{%- assign max_rows = 10 -%}
{%- assign rows = 0 -%}
{%- assign stop = false -%}

<div class="layout layout--col layout--top layout--stretch-x gap--small p--0">
  {%- for date in dates -%}
    {%- if stop -%}{%- break -%}{%- endif -%}

    {%- comment -%} All-day events for this date, alphabetical. Summaries are all we
         need since these render without a time. {%- endcomment -%}
    {%- capture ad_blob -%}{%- for e in events -%}{%- assign ed = e.date_time | date: '%Y-%m-%d' -%}{%- if ed == date and e.all_day -%}{{ e.summary }}~{%- endif -%}{%- endfor -%}{%- endcapture -%}
    {%- assign ad_names = ad_blob | split: '~' | sort_natural -%}
    {%- assign ad_count = ad_names | size -%}

    {%- assign timed_count = 0 -%}
    {%- for e in events -%}
      {%- assign ed = e.date_time | date: '%Y-%m-%d' -%}
      {%- if ed == date -%}{%- unless e.all_day -%}{%- assign timed_count = timed_count | plus: 1 -%}{%- endunless -%}{%- endif -%}
    {%- endfor -%}
    {%- assign day_total = ad_count | plus: timed_count -%}

    {%- comment -%} A day needs room for its heading AND at least one row, or we stop
         entirely — prevents an orphaned heading clipped at the bottom edge. {%- endcomment -%}
    {%- assign needed = rows | plus: 2 -%}
    {%- if needed > max_rows -%}{%- assign stop = true -%}{%- break -%}{%- endif -%}

    {%- if date == today -%}
      <div class="label label--large text--bold w--full bg--black text--white px--3" style="{{ head_padding }}; {{ head_size }};">TODAY</div>
    {%- elsif date == tomorrow -%}
      <div class="label label--large text--bold w--full bg--gray-70 px--3" style="{{ head_padding }}; {{ head_size }};">TOMORROW</div>
    {%- else -%}
      <div class="label label--large text--bold w--full bg--gray-70 px--3" style="{{ head_padding }}; {{ head_size }};">{{ date | date: '%A, %b %-d' | upcase }}</div>
    {%- endif -%}
    {%- assign rows = rows | plus: 1 -%}

    {%- if day_total == 0 -%}
      <div class="label label--large px--3" style="font-style: italic; {{ event_padding }} font-size:16px;">Nothing scheduled today</div>
      {%- assign rows = rows | plus: 1 -%}
    {%- endif -%}

    {%- comment -%} All-day first, no time shown. {%- endcomment -%}
    {%- for name in ad_names -%}
      {%- assign next_rows = rows | plus: 1 -%}
      {%- if next_rows > max_rows -%}{%- assign stop = true -%}{%- break -%}{%- endif -%}
      <div class="flex flex--row flex--between flex--center-y gap--small w--full px--3">
        <span class="label label--large" style="{{ event_padding }} {{ event_size }}">{{ name }}</span>
      </div>
      {%- assign rows = next_rows -%}
    {%- endfor -%}

    {%- comment -%} Then timed events, in calendar order, with the time pill. {%- endcomment -%}
    {%- unless stop -%}
      {%- for e in events -%}
        {%- assign ed = e.date_time | date: '%Y-%m-%d' -%}
        {%- if ed == date -%}
          {%- unless e.all_day -%}
            {%- assign next_rows = rows | plus: 1 -%}
            {%- if next_rows > max_rows -%}{%- assign stop = true -%}{%- break -%}{%- endif -%}
            <div class="flex flex--row flex--between flex--center-y gap--small w--full px--3" style="display: flex; align-items: flex-start;">
              <span class="label label--large" style="{{ event_padding }} {{ event_size }}">{{ e.summary }}</span>
              <span class="label label--large label--outline no-shrink" style="font-size:15px; margin-top:8px">{{ e.start }}</span>
            </div>
            {%- assign rows = next_rows -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  {%- endfor -%}
</div>